<idea-plugin>
  <id>dev.nickl0s.opencode-selection-reference</id>
  <name>Coding Agent Toolkit</name>
  <vendor email="local@localhost">n1ckl0s</vendor>

  <description><![CDATA[
    Copy selected code as a project-relative file and line reference, for example
    <code>@src/main.js#L10-25</code>.
    Use a configurable shortcut to toggle a file's inclusion from the Commit diff.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="commit-diff.xml">com.intellij.modules.vcs</depends>
  <dependencies>
    <module name="intellij.platform.vcs.impl.shared"/>
  </dependencies>

  <actions>
    <action id="dev.nickl0s.opencode.CopySelectionReference"
            class="dev.nickl0s.opencode.CopyOpenCodeReferenceAction"
            text="Copy Code Reference"
            description="Copy the selected range as @path#Lstart-end">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>

